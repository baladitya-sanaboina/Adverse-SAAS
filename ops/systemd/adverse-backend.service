[Unit]
Description=Adverse FastAPI backend
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=adverse
Group=adverse
WorkingDirectory=/opt/adverse/current/backend
EnvironmentFile=/etc/adverse/backend.env
ExecStart=/opt/adverse/current/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
