# Copy to frontend/Manager/.env.production (git-ignored) before building the production image.
# NEXT_PUBLIC_ values are built into the browser code: never put secrets in them.
NEXT_PUBLIC_APP_NAME=Adverse Manager Workspace
NEXT_PUBLIC_APP_VERSION=0.37.0
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=false

# The browser never calls the API directly; the app's server does (BACKEND_INTERNAL_URL is set
# by docker-compose.prod.yml). These two stay on the internal address.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_BACKEND_HEALTH_URL=https://api.example.com/health

NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com
NEXT_PUBLIC_MANAGER_APP_URL=https://manager.example.com
NEXT_PUBLIC_EMPLOYEE_APP_URL=https://employee.example.com
NEXT_PUBLIC_CLIENT_APP_URL=https://client.example.com
