# Production API image: no code reload, several workers, runs as a normal user.
# Built by docker-compose.prod.yml (context: backend/). See docs/Deployment.md.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.txt

COPY main.py ./
COPY app ./app

RUN useradd --create-home --uid 10001 adverse \
    && mkdir -p storage private-storage \
    && chown -R adverse:adverse /app
USER adverse

EXPOSE 8000

# Workers share live events, reminders and rate limits through Redis, so more than one is safe.
# Live event streams never close by themselves; a short graceful timeout keeps restarts quick.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-2} --proxy-headers --forwarded-allow-ips '*' --timeout-graceful-shutdown 5"]
