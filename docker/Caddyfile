# HTTPS for the four apps and the API. Caddy gets and renews the certificates by itself; point
# each domain's DNS A record at this server first. Live updates (server-sent events) are flushed
# immediately.
{
	email {$ACME_EMAIL}
}

(app) {
	encode zstd gzip
	header -Server
}

{$ADMIN_DOMAIN} {
	import app
	reverse_proxy 127.0.0.1:3000
}

{$MANAGER_DOMAIN} {
	import app
	reverse_proxy 127.0.0.1:3001
}

{$EMPLOYEE_DOMAIN} {
	import app
	reverse_proxy 127.0.0.1:3002
}

{$CLIENT_DOMAIN} {
	import app
	reverse_proxy 127.0.0.1:3003
}

{$API_DOMAIN} {
	import app
	reverse_proxy 127.0.0.1:8000
}

# Extra sites, such as the dev site (scripts/production/install_dev_site.sh writes
# /etc/caddy/sites.d/adverse-dev.caddy). Nothing there = nothing extra is served.
import /etc/caddy/sites.d/*.caddy
