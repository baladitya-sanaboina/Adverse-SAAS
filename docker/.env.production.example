# Copy to docker/.env.production (git-ignored) and fill in. Used by docker-compose.prod.yml.
# Make secrets with:  openssl rand -base64 36

# Public domains (DNS A records pointing at this server)
ADMIN_DOMAIN=admin.example.com
MANAGER_DOMAIN=manager.example.com
EMPLOYEE_DOMAIN=employee.example.com
CLIENT_DOMAIN=client.example.com
API_DOMAIN=api.example.com
# Let's Encrypt contact for certificate expiry notices
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Meet relay (coturn). TURN_REALM is usually your main domain; TURN_EXTERNAL_IP is the server's
# public IP. The same TURN_SECRET is given to the API so it can issue short-lived credentials.
TURN_REALM=example.com
TURN_EXTERNAL_IP=
TURN_SECRET=

# API worker processes (1 is safer on a tiny VPS; raise it on bigger servers)
WEB_CONCURRENCY=1

# Tiny-VPS memory tuning defaults used by docker-compose.prod.yml; raise them on larger servers.
NODE_OPTIONS=--max-old-space-size=160
NODE_BUILD_OPTIONS=--max-old-space-size=384
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=40
REDIS_MAXMEMORY=64mb
