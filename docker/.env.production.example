# Copy to docker/.env.production (git-ignored) and fill in. Used by docker-compose.prod.yml.
# Make secrets with:  openssl rand -base64 36

# Public domains (DNS A records pointing at this server)
ADMIN_DOMAIN=admin.example.com
MANAGER_DOMAIN=manager.example.com
EMPLOYEE_DOMAIN=team.example.com
CLIENT_DOMAIN=client.example.com
# Let's Encrypt contact for certificate expiry notices
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Meet relay (coturn). TURN_REALM is usually your main domain; TURN_EXTERNAL_IP is the server's
# public IP. The same TURN_SECRET is given to the API so it can issue short-lived credentials.
TURN_REALM=example.com
TURN_EXTERNAL_IP=
TURN_SECRET=

# API worker processes (2 is right for a 2-4 CPU server)
WEB_CONCURRENCY=2
