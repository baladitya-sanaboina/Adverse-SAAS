APP_NAME=Adverse API
APP_VERSION=0.37.0
APP_DESCRIPTION=Adverse platform and company service API
APP_AUTHOR=Adverse
ENVIRONMENT=development
API_PREFIX=
DATABASE_URL=postgresql://loopless:loopless@postgres:5432/loopless_dev
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-development-only-at-least-32-characters
JWT_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_RESEND_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
INVITATION_EXPIRY_HOURS=48
STORAGE_PROVIDER=local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@adverse.local
SMTP_USE_TLS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
LOG_LEVEL=INFO
SWAGGER_ENABLED=true
HEALTH_CHECK_ENABLED=true
SWAGGER_CONTACT_NAME=Adverse API Team
SWAGGER_CONTACT_EMAIL=api@adverse.example.com
SWAGGER_CONTACT_URL=https://adverse.local

PUBLIC_SIGNUP_ENABLED=false
