// ---------------------------------------------------------------------------
// Production management (docs/ProductionManagementPlan.md, section 6)
// People are referenced by users.id, matching ServicePricing.managerUserId.
// ---------------------------------------------------------------------------

model Task {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  number             Int
  clientId           String                 @map("client_id") @db.Uuid
  serviceId          String                 @map("service_id") @db.Uuid
  title              String
  description        String                 @default("")
  priority           TaskPriority           @default(MEDIUM)
  status             TaskStatus             @default(PENDING)
  assigneeUserId     String?                @map("assignee_user_id") @db.Uuid
  assigneeType       TaskAssigneeType?      @map("assignee_type")
  monitorUserId      String?                @map("monitor_user_id") @db.Uuid
  dueDate            DateTime?              @map("due_date") @db.Date
  currency           String                 @default("INR") @db.VarChar(3)
  clientPricingModel ServicePricingModel    @map("client_pricing_model")
  clientPriceDefault Decimal?               @map("client_price_default") @db.Decimal(12, 2)
  clientPriceFinal   Decimal                @map("client_price_final") @db.Decimal(12, 2)
  clientPriceReason  String                 @default("") @map("client_price_reason")
  commissionDefault  Decimal?               @map("commission_default") @db.Decimal(12, 2)
  commissionFinal    Decimal?               @map("commission_final") @db.Decimal(12, 2)
  commissionReason   String                 @default("") @map("commission_reason")
  createdById        String                 @map("created_by_id") @db.Uuid
  assignedAt         DateTime?              @map("assigned_at")
  startedAt          DateTime?              @map("started_at")
  submittedAt        DateTime?              @map("submitted_at")
  approvedAt         DateTime?              @map("approved_at")
  completedAt        DateTime?              @map("completed_at")
  cancelledAt        DateTime?              @map("cancelled_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service            CompanyService         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignee           User?                  @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  monitor            User?                  @relation("TaskMonitor", fields: [monitorUserId], references: [id], onDelete: SetNull)
  createdBy          User                   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  statusHistory      TaskStatusHistory[]
  priceChanges       TaskPriceChange[]
  comments           TaskComment[]
  files              TaskFile[]
  invoiceLines       InvoiceLine[]
  calendarEntries    ContentCalendarEntry[]
  packageId          String?                @map("package_id") @db.Uuid
  package            ClientPackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status, dueDate])
  @@index([companyId, clientId, status])
  @@index([companyId, serviceId, status])
  @@index([companyId, assigneeUserId, status])
  @@index([companyId, monitorUserId, status])
  @@index([companyId, approvedAt])
  @@index([packageId])
  @@map("tasks")
}

/// Monthly package (owner request 2026-11-15): a fixed monthly price covers some videos;
/// extra videos are billed at the per-item rate. Ended and replaced, never edited in place.
model ClientPackage {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  name           String    @db.VarChar(120)
  monthlyPrice   Decimal   @map("monthly_price") @db.Decimal(12, 2)
  videosIncluded Int       @map("videos_included")
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User      @relation("ClientPackageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks          Task[]

  @@index([companyId, clientId, startsOn])
  @@map("client_packages")
}

model TaskStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  actorId    String      @map("actor_id") @db.Uuid
  note       String      @default("")
  createdAt  DateTime    @default(now()) @map("created_at")
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor      User        @relation("TaskStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([companyId, createdAt])
  @@map("task_status_history")
}

model TaskPriceChange {
