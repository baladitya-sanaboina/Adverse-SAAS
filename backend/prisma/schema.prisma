generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum RegistrationAction {
  USER_CREATED
  COMPANY_CREATED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthenticationEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH_USED
  LOGOUT
  TOKEN_REVOKED
  SESSION_EXPIRED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  ACCOUNT_LOCKED
}

enum ProfileAuditAction {
  PROFILE_UPDATED
  PASSWORD_CHANGED
  PROFILE_IMAGE_UPDATED
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

enum CompanySubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Company {
  id                  String                         @id @default(uuid()) @db.Uuid
  name                String                         @unique
  description         String?
  code                String                         @unique
  subscriptionPlan    String                         @map("subscription_plan")
  status              CompanyStatus                  @default(ACTIVE)
  contactEmail        String?                        @unique @map("contact_email")
  phone               String?
  address             String?
  website             String?
  timezone            String                         @default("UTC")
  language            String                         @default("en")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  users               User[]
  registrationLogs    RegistrationAudit[]
  authSessions        AuthSession[]
  managementAudits    CompanyManagementAudit[]
  subscription        CompanySubscription?
  subscriptionAudits  SubscriptionAudit[]
  usageMetrics        CompanyUsageMetric?
  usageAlerts         SubscriptionUsageAlert[]
  enforcementAudits   SubscriptionEnforcementAudit[]
  onboarding          CompanyOnboarding?
  tenantDefaults      CompanyTenantDefault?
  onboardingAudits    CompanyOnboardingAudit[]
  settingAudits       CompanySettingAudit[]
  departments         Department[]
  branches            Branch[]
  roles               Role[]
  employees           Employee[]
  employeeAudits      EmployeeAudit[]
  clients             Client[]
  clientNotes         ClientNote[]
  clientFeedback      ClientFeedback[]
  clientActivities    ClientActivity[]
  services            CompanyService[]
  servicePricing      ServicePricing[]
  leads               Lead[]
  opportunities       Opportunity[]
  crmAudits           CrmAudit[]
  tasks               Task[]
  taskStatusHistory   TaskStatusHistory[]
  taskPriceChanges    TaskPriceChange[]
  taskComments        TaskComment[]
  notifications       Notification[]
  invoices            Invoice[]
  clientPackages      ClientPackage[]
  calendarEntries     ContentCalendarEntry[]
  chatConversations   ChatConversation[]
  chatMessages        ChatMessage[]
  taskFiles           TaskFile[]
  clientBudgetEntries ClientBudgetEntry[]
  clientPayments      ClientPayment[]
  employeeSalaries    EmployeeSalary[]
  salaryPayments      SalaryPayment[]
  managerPayouts      ManagerPayout[]

  @@index([status, createdAt])
  @@index([subscriptionPlan, status])
  @@map("companies")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  EMAIL
  PHONE
  SOCIAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum ServicePricingModel {
  PER_VIDEO
  PER_PIECE
  MONTHLY_FIXED
  MONTHLY_PACKAGE
  COMMISSION_PER_DELIVERABLE
}

enum ServicePricingScope {
  CLIENT
  MANAGER
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeType {
  MANAGER
  EMPLOYEE
}

enum TaskFileKind {
  REFERENCE
  DELIVERABLE
}

enum TaskPriceField {
  CLIENT_PRICE
  COMMISSION
}

enum ClientBudgetEntryType {
  INITIAL
  TOP_UP
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model Department {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  name        String
  description String             @default("")
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  employees   Employee[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("departments")
}

model Branch {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  name      String
  code      String
  address   String             @default("")
  city      String             @default("")
  state     String             @default("")
  country   String             @default("")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]
  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("branches")
}

model SubscriptionPlan {
  id            String                    @id @default(uuid()) @db.Uuid
  name          String
  code          String                    @unique
  description   String?
  monthlyPrice  Decimal                   @default(0) @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice   Decimal                   @default(0) @map("yearly_price") @db.Decimal(12, 2)
  status        SubscriptionPlanStatus    @default(ACTIVE)
  displayOrder  Int                       @default(0) @map("display_order")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  features      SubscriptionPlanFeature[]
  limits        SubscriptionPlanLimit[]
  subscriptions CompanySubscription[]
  audits        SubscriptionAudit[]

  @@index([status, displayOrder])
  @@map("subscription_plans")
}

model SubscriptionPlanFeature {
  planId      String           @map("plan_id") @db.Uuid
  featureCode String           @map("feature_code")
  enabled     Boolean          @default(false)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureCode])
  @@map("subscription_plan_features")
}

model SubscriptionPlanLimit {
  planId    String           @map("plan_id") @db.Uuid
  limitCode String           @map("limit_code")
  value     BigInt?
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, limitCode])
  @@map("subscription_plan_limits")
}

model CompanySubscription {
  id             String                    @id @default(uuid()) @db.Uuid
  companyId      String                    @unique @map("company_id") @db.Uuid
  planId         String                    @map("plan_id") @db.Uuid
  status         CompanySubscriptionStatus @default(ACTIVE)
  activationDate DateTime                  @default(now()) @map("activation_date")
  expirationDate DateTime?                 @map("expiration_date")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("company_subscriptions")
}

model SubscriptionAudit {
  id        String           @id @default(uuid()) @db.Uuid
  actorId   String           @map("actor_id") @db.Uuid
  companyId String?          @map("company_id") @db.Uuid
  planId    String           @map("plan_id") @db.Uuid
  action    String
  details   String?
  createdAt DateTime         @default(now()) @map("created_at")
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([companyId, createdAt])
  @@index([planId, createdAt])
  @@map("subscription_audits")
}

model CompanyUsageMetric {
  companyId        String   @id @map("company_id") @db.Uuid
  projectsUsed     BigInt   @default(0) @map("projects_used")
  storageUsedBytes BigInt   @default(0) @map("storage_used_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_usage_metrics")
}

model SubscriptionUsageAlert {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  resourceCode String   @map("resource_code")
  level        String
  message      String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, resourceCode])
  @@index([companyId, active])
  @@map("subscription_usage_alerts")
}

model SubscriptionEnforcementAudit {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  actorId         String?  @map("actor_id") @db.Uuid
  planId          String?  @map("plan_id") @db.Uuid
  eventType       String   @map("event_type")
  resourceCode    String?  @map("resource_code")
  currentUsage    BigInt?  @map("current_usage")
  configuredLimit BigInt?  @map("configured_limit")
  details         String?
  createdAt       DateTime @default(now()) @map("created_at")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([eventType, createdAt])
  @@map("subscription_enforcement_audits")
}

model Role {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String?            @map("company_id") @db.Uuid
  name            String
  code            String             @unique
  description     String             @default("")
  status          OrganizationStatus @default(ACTIVE)
  isSystem        Boolean            @default(false) @map("is_system")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users           User[]
  employees       Employee[]
  rolePermissions RolePermission[]

  @@index([companyId, name])
  @@index([companyId, status])
  @@map("roles")
}

model Module {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  code            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("modules")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  code            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  moduleId     String     @map("module_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId, permissionId])
  @@index([moduleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  status                  UserStatus               @default(ACTIVE)
  companyId               String?                  @map("company_id") @db.Uuid
  roleId                  String                   @map("role_id") @db.Uuid
  departmentId            String?                  @map("department_id") @db.Uuid
  branchId                String?                  @map("branch_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  firstName               String?                  @map("first_name")
  lastName                String?                  @map("last_name")
  phoneNumber             String?                  @map("phone_number")
  profileImageUrl         String?                  @map("profile_image_url")
  timezone                String                   @default("UTC")
  language                String                   @default("en")
  themePreference         String                   @default("system") @map("theme_preference")
  emailNotifications      Boolean                  @default(true) @map("email_notifications")
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until")
  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch                  Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  registrationActions     RegistrationAudit[]      @relation("RegistrationActor")
  registrationCreations   RegistrationAudit[]      @relation("RegistrationCreatedUser")
  sessions                AuthSession[]
  authenticationEvents    AuthenticationEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  profileAudits           ProfileAudit[]
  userPermissions         UserPermission[]
  developerAuditActions   DeveloperAudit[]         @relation("DeveloperAuditActor")
  developerAuditTargets   DeveloperAudit[]         @relation("DeveloperAuditTarget")
  companyManagementAudits CompanyManagementAudit[]
  subscriptionAudits      SubscriptionAudit[]
  platformSettingAudits   PlatformSettingAudit[]
  onboardingActions       CompanyOnboardingAudit[] @relation("OnboardingActor")
  onboardingRecords       CompanyOnboarding[]      @relation("OnboardingActor")
  companySettingAudits    CompanySettingAudit[]
  employeeProfile         Employee?
  employeeAuditActions    EmployeeAudit[]          @relation("EmployeeAuditActor")
  crmAuditActions         CrmAudit[]               @relation("CrmAuditActor")
  clientNotesCreated      ClientNote[]             @relation("ClientNoteCreator")
  clientFeedbackCreated   ClientFeedback[]         @relation("ClientFeedbackCreator")
  clientActivityActions   ClientActivity[]         @relation("ClientActivityActor")
  clientAccountProfile    Client?                  @relation("ClientAccountUser")
  managerPricingRecords   ServicePricing[]         @relation("ManagerPricingUser")
  servicePricingChanges   ServicePricing[]         @relation("ServicePricingActor")
  tasksCreated            Task[]                   @relation("TaskCreator")
  tasksAssigned           Task[]                   @relation("TaskAssignee")
  tasksMonitored          Task[]                   @relation("TaskMonitor")
  taskStatusChanges       TaskStatusHistory[]      @relation("TaskStatusActor")
  taskPriceChanges        TaskPriceChange[]        @relation("TaskPriceActor")
  taskComments            TaskComment[]            @relation("TaskCommentAuthor")
  notifications           Notification[]           @relation("NotificationRecipient")
  invoicesCreated         Invoice[]                @relation("InvoiceCreator")
  clientPackagesCreated   ClientPackage[]          @relation("ClientPackageCreator")
  calendarEntriesCreated  ContentCalendarEntry[]   @relation("CalendarEntryCreator")
  chatConversationsMade   ChatConversation[]       @relation("ChatConversationCreator")
  chatMemberships         ChatMember[]
  chatMessagesSent        ChatMessage[]            @relation("ChatMessageSender")
  chatStatus              ChatStatus?
  chatCallsStarted        ChatCall[]               @relation("ChatCallStarter")
  chatCallAdmissions      ChatCallAdmission[]      @relation("ChatCallAdmissionUser")
  chatCallAdmissionsMade  ChatCallAdmission[]      @relation("ChatCallAdmissionDecider")
  chatCallSeats           ChatCallParticipant[]
  chatMeetingsMade        ChatMeeting[]            @relation("ChatMeetingCreator")
  chatReactions           ChatReaction[]
  taskFilesUploaded       TaskFile[]               @relation("TaskFileUploader")
  clientBudgetEntries     ClientBudgetEntry[]      @relation("ClientBudgetActor")
  clientPaymentsRecorded  ClientPayment[]          @relation("ClientPaymentActor")
  salaries                EmployeeSalary[]         @relation("SalaryEmployee")
  salariesSet             EmployeeSalary[]         @relation("SalaryActor")
  salaryPayments          SalaryPayment[]          @relation("SalaryPaymentEmployee")
  salaryPaymentsRecorded  SalaryPayment[]          @relation("SalaryPaymentActor")
  managerPayouts          ManagerPayout[]          @relation("PayoutManager")
  managerPayoutsRecorded  ManagerPayout[]          @relation("PayoutActor")

  @@index([companyId])
  @@index([roleId])
  @@index([departmentId])
  @@index([branchId])
  @@index([roleId, status, createdAt])
  @@map("users")
}

model Employee {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  userId             String          @unique @map("user_id") @db.Uuid
  employeeCode       String          @map("employee_code")
  departmentId       String?         @map("department_id") @db.Uuid
  branchId           String?         @map("branch_id") @db.Uuid
  roleId             String          @map("role_id") @db.Uuid
  status             EmployeeStatus  @default(PENDING)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  department         Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch             Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role               Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  audits             EmployeeAudit[]
  ownedLeads         Lead[]
  ownedOpportunities Opportunity[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
  @@index([departmentId])
  @@index([branchId])
  @@index([roleId])
  @@map("employees")
}

model EmployeeAudit {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor      User     @relation("EmployeeAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([employeeId, createdAt])
  @@index([actorId, createdAt])
  @@map("employee_audits")
}

model Client {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @map("company_id") @db.Uuid
  userId                String?                @unique @map("user_id") @db.Uuid
  name                  String
  code                  String
  email                 String?
  phone                 String?
  website               String?
  address               String                 @default("")
  city                  String                 @default("")
  state                 String                 @default("")
  country               String                 @default("")
  status                OrganizationStatus     @default(ACTIVE)
  gstEnabled            Boolean                @default(false) @map("gst_enabled")
  gstRate               Decimal                @default(18) @map("gst_rate") @db.Decimal(5, 2)
  gstin                 String                 @default("") @db.VarChar(20)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountUser           User?                  @relation("ClientAccountUser", fields: [userId], references: [id], onDelete: SetNull)
  contacts              ClientContact[]
  notes                 ClientNote[]
  feedback              ClientFeedback[]
  activities            ClientActivity[]
  servicePricingRecords ServicePricing[]
  tasks                 Task[]
  budgetEntries         ClientBudgetEntry[]
  payments              ClientPayment[]
  invoices              Invoice[]
  packages              ClientPackage[]
  calendarEntries       ContentCalendarEntry[]
  chatRooms             ChatConversation[]
  leads                 Lead[]
  opportunities         Opportunity[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, email])
  @@map("clients")
}

model ClientContact {
  id          String             @id @default(uuid()) @db.Uuid
  clientId    String             @map("client_id") @db.Uuid
  firstName   String             @map("first_name")
  lastName    String             @default("") @map("last_name")
  email       String?
  phone       String?
  designation String             @default("")
  isPrimary   Boolean            @default(false) @map("is_primary")
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId, status])
  @@index([clientId, isPrimary])
  @@map("client_contacts")
}

model ClientNote {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ClientNoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, clientId, createdAt])
  @@index([createdById])
  @@map("client_notes")
}

model ClientFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ClientFeedbackCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, clientId, createdAt])
  @@index([createdById])
  @@map("client_feedback")
}

model ClientActivity {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  type        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor       User     @relation("ClientActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, clientId, createdAt])
  @@index([actorId])
  @@map("client_activities")
}

model CompanyService {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  name                String
  code                String
  description         String              @default("")
  clientPricingModel  ServicePricingModel @map("client_pricing_model")
  managerPricingModel ServicePricingModel @map("manager_pricing_model")
  status              OrganizationStatus  @default(ACTIVE)
  sortOrder           Int                 @default(0) @map("sort_order")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pricingRecords      ServicePricing[]
  tasks               Task[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status, sortOrder])
  @@index([companyId, name])
  @@map("company_services")
}

model ServicePricing {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  serviceId     String              @map("service_id") @db.Uuid
  scope         ServicePricingScope
  clientId      String?             @map("client_id") @db.Uuid
  managerUserId String?             @map("manager_user_id") @db.Uuid
  pricingModel  ServicePricingModel @map("pricing_model")
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("INR") @db.VarChar(3)
  notes         String              @default("")
  effectiveFrom DateTime            @map("effective_from")
  effectiveTo   DateTime?           @map("effective_to")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service       CompanyService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  managerUser   User?               @relation("ManagerPricingUser", fields: [managerUserId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("ServicePricingActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, serviceId, scope, effectiveFrom])
  @@index([companyId, clientId, effectiveFrom])
  @@index([companyId, managerUserId, effectiveFrom])
  @@index([createdById, createdAt])
  @@map("service_pricing")
}

model Lead {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  clientId      String?       @map("client_id") @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  name          String
  companyName   String        @default("") @map("company_name")
  email         String?
  phone         String?
  source        LeadSource    @default(OTHER)
  status        LeadStatus    @default(NEW)
  notes         String        @default("")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner         Employee      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, source])
  @@index([clientId])
  @@map("leads")
}

model Opportunity {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  clientId          String            @map("client_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  name              String
  description       String            @default("")
  value             Decimal           @default(0) @db.Decimal(18, 2)
  currency          String            @default("INR") @db.VarChar(3)
  stage             OpportunityStage  @default(NEW)
  status            OpportunityStatus @default(OPEN)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner             Employee          @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([companyId, stage])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([clientId])
  @@index([leadId])
  @@map("opportunities")
}

