/// In-app notification for one user (owner request 2026-11-14). Delivered live over the realtime
/// stream and kept here for the bell and the Notifications page.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String    @default("") @db.VarChar(500)
  link      String    @default("") @db.VarChar(300)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// Client invoice (owner request 2026-11-14): a snapshot of the work delivered in a period
/// (usually one budget top-up) plus the payments received in that period. No tax for now.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  number        Int
  prefix        String        @default("ADV") @db.VarChar(8)
  status        InvoiceStatus @default(DRAFT)
  source        String        @default("MANUAL") @db.VarChar(20)
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  currency      String        @db.VarChar(3)
  subtotal      Decimal       @db.Decimal(12, 2)
  paymentsTotal Decimal       @map("payments_total") @db.Decimal(12, 2)
  budgetAdded   Decimal       @map("budget_added") @db.Decimal(12, 2)
  payments      Json          @default("[]")
  notes         String        @default("") @db.VarChar(1000)
  taxRate       Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  clientGstin   String        @default("") @map("client_gstin") @db.VarChar(20)
  createdById   String        @map("created_by_id") @db.Uuid
  sentAt        DateTime?     @map("sent_at")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId, clientId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  position    Int
  deliveredOn DateTime @map("delivered_on") @db.Date
  title       String   @db.VarChar(200)
  serviceName String   @map("service_name") @db.VarChar(120)
  amount      Decimal  @db.Decimal(12, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

/// Content calendar (Phase 13, owner decision 2026-11-14): the client plans what to shoot and
/// post on which day. The client ticks Recorded, Script, Instagram and YouTube; "Edited" is true
/// when the linked task is approved (or the admin ticks it by hand). The admin can change anything.
model ContentCalendarEntry {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  entryDate         DateTime @map("entry_date") @db.Date
  title             String   @db.VarChar(200)
  referenceUrl      String   @default("") @map("reference_url") @db.VarChar(1000)
  scriptUrl         String   @default("") @map("script_url") @db.VarChar(1000)
  pdfUrl            String   @default("") @map("pdf_url") @db.VarChar(1000)
  notes             String   @default("") @db.VarChar(2000)
  noPost            Boolean  @default(false) @map("no_post")
  recorded          Boolean  @default(false)
  scriptReady       Boolean  @default(false) @map("script_ready")
  postedInstagram   Boolean  @default(false) @map("posted_instagram")
  postedYoutube     Boolean  @default(false) @map("posted_youtube")
  editedManual      Boolean  @default(false) @map("edited_manual")
  scriptFileName    String?  @map("script_file_name") @db.VarChar(200)
  scriptStoragePath String?  @map("script_storage_path") @db.VarChar(500)
  scriptMimeType    String?  @map("script_mime_type") @db.VarChar(200)
  scriptSizeBytes   BigInt?  @map("script_size_bytes")
  taskId            String?  @map("task_id") @db.Uuid
  createdById       String   @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task              Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy         User     @relation("CalendarEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, entryDate])
  @@index([companyId, clientId, entryDate])
  @@index([taskId])
  @@map("content_calendar_entries")
}

enum ChatConversationType {
  DIRECT
  GROUP
  CLIENT
}

/// Chat (Phase 14, owner decisions 2026-11-14): client rooms the admin creates by hand (the
/// client, the admin and the staff the admin adds), direct chats (staff with staff, a client with
/// the admin) and staff groups.
model ChatConversation {
  id            String               @id @default(uuid()) @db.Uuid
  companyId     String               @map("company_id") @db.Uuid
  type          ChatConversationType
  title         String               @default("") @db.VarChar(120)
  clientId      String?              @map("client_id") @db.Uuid
  directKey     String?              @map("direct_key") @db.VarChar(80)
  createdById   String               @map("created_by_id") @db.Uuid
  lastMessageAt DateTime?            @map("last_message_at")
  /// Code in the chat's meet link (/call/<code>), made the first time someone asks for the link.
  meetCode      String?              @unique @map("meet_code") @db.VarChar(16)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       ChatMember[]
  messages      ChatMessage[]
  calls         ChatCall[]
  meetings      ChatMeeting[]

  @@unique([companyId, directKey])
  @@index([companyId, lastMessageAt])
  @@index([clientId])
  @@map("chat_conversations")
}

/// Members of every chat, with read state. Admins also see every client room.
model ChatMember {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  isMember       Boolean          @default(true) @map("is_member")
  lastReadAt     DateTime?        @map("last_read_at")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  senderId       String           @map("sender_id") @db.Uuid
  body           String           @default("") @db.VarChar(4000)
  replyToId      String?          @map("reply_to_id") @db.Uuid
  editedAt       DateTime?        @map("edited_at")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo        ChatMessage?     @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("ChatReply")
  attachments    ChatAttachment[]
  reactions      ChatReaction[]

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id          String      @id @default(uuid()) @db.Uuid
  messageId   String      @map("message_id") @db.Uuid
  fileName    String      @map("file_name") @db.VarChar(200)
  storagePath String      @map("storage_path") @db.VarChar(500)
  mimeType    String      @map("mime_type") @db.VarChar(200)
  sizeBytes   BigInt      @map("size_bytes")
  createdAt   DateTime    @default(now()) @map("created_at")
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("chat_attachments")
}

enum ChatStatusValue {
  AVAILABLE
  BUSY
  AWAY
}

/// The status a person sets for chat (owner request 2026-11-14). Shown as Offline while they do
/// not have the app open.
model ChatStatus {
  userId    String          @id @map("user_id") @db.Uuid
  status    ChatStatusValue @default(AVAILABLE)
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_statuses")
}

/// Emoji reactions on chat messages (owner request 2026-11-14: a more advanced chat).
model ChatReaction {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  emoji     String      @db.VarChar(16)
  createdAt DateTime    @default(now()) @map("created_at")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

enum ChatCallKind {
  AUDIO
  VIDEO
}

/// Audio and video calls in a chat (owner request 2026-11-14: "like Google Meet / Zoom").
/// Media goes browser to browser (WebRTC); the server only signals and keeps this record.
model ChatCall {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  kind           ChatCallKind
  startedById    String                @map("started_by_id") @db.Uuid
  startedAt      DateTime              @default(now()) @map("started_at")
  endedAt        DateTime?             @map("ended_at")
  conversation   ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy      User                  @relation("ChatCallStarter", fields: [startedById], references: [id], onDelete: Cascade)
  participants   ChatCallParticipant[]
  admissions     ChatCallAdmission[]

  @@index([conversationId, endedAt])
  @@map("chat_calls")
}

model ChatCallParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  callId     String    @map("call_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  leftAt     DateTime? @map("left_at")
  call       ChatCall  @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@map("chat_call_participants")
}

/// Someone outside the chat who opened its meet link and asked to join a running call. The
/// call's host or an admin in the call admits or denies them (owner decision 2026-11-14).
model ChatCallAdmission {
  id          String                  @id @default(uuid()) @db.Uuid
  callId      String                  @map("call_id") @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  status      ChatCallAdmissionStatus @default(WAITING)
  requestedAt DateTime                @default(now()) @map("requested_at")
  lastSeenAt  DateTime                @default(now()) @map("last_seen_at")
  decidedAt   DateTime?               @map("decided_at")
  decidedById String?                 @map("decided_by_id") @db.Uuid
  call        ChatCall                @relation(fields: [callId], references: [id], onDelete: Cascade)
  user        User                    @relation("ChatCallAdmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User?                   @relation("ChatCallAdmissionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([callId, userId])
  @@map("chat_call_admissions")
}

enum ChatCallAdmissionStatus {
  WAITING
  ADMITTED
  DENIED
}

/// A meeting scheduled in a chat; everyone in the chat sees it on their calendar and joins the
/// chat's call from it.
model ChatMeeting {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  conversationId  String           @map("conversation_id") @db.Uuid
  title           String           @db.VarChar(160)
  notes           String           @default("") @db.VarChar(1000)
  startsAt        DateTime         @map("starts_at")
  durationMinutes Int              @default(30) @map("duration_minutes")
  kind            ChatCallKind     @default(VIDEO)
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  cancelledAt     DateTime?        @map("cancelled_at")
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("ChatMeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, startsAt])
  @@index([conversationId, startsAt])
  @@map("chat_meetings")
}
