# Copy to backend/.env.production (git-ignored) and fill in. DATABASE_URL, REDIS_URL, TURN_SECRET
# and ENVIRONMENT come from docker-compose.prod.yml, so they are not set here.
APP_NAME=Adverse API
APP_VERSION=0.37.0
APP_DESCRIPTION=Adverse platform and company service API
APP_AUTHOR=Adverse
API_PREFIX=

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_RESEND_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
INVITATION_EXPIRY_HOURS=48
STORAGE_PROVIDER=local

# Outgoing mail (Gmail: an App Password from myaccount.google.com/apppasswords, 2-step on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Adverse
MAIL_REPEAT_WINDOW_MINUTES=30

# The four app addresses, in this order: Admin, Manager, Employee, Client. Used for CORS and for
# the links inside emails.
CORS_ORIGINS=https://admin.example.com,https://manager.example.com,https://team.example.com,https://client.example.com

# Meet relay (see docker/.env.production for the secret)
TURN_URLS=turn:example.com:3478?transport=udp,turn:example.com:3478?transport=tcp
TURN_TTL_SECONDS=21600

LOG_LEVEL=INFO
SWAGGER_ENABLED=false
HEALTH_CHECK_ENABLED=true
PUBLIC_SIGNUP_ENABLED=false
